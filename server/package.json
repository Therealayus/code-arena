{
  "name": "color-arena-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "test": "ts-node --transpile-only tests/payout.test.ts",
    "test:bonus": "ts-node --transpile-only tests/bonus.test.ts",
    "test:settlement": "ts-node --transpile-only tests/settlement.test.ts",
    "test:referral": "ts-node --transpile-only tests/referral.test.ts",
    "test:race": "ts-node --transpile-only tests/money-race.test.ts",
    "test:admin": "ts-node --transpile-only tests/admin.test.ts",
    "test:password": "ts-node --transpile-only tests/password.test.ts",
    "test:all": "npm test && npm run test:bonus && npm run test:settlement && npm run test:referral && npm run test:admin && npm run test:password && npm run test:race"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
